# 이 파일을 .env.local 로 복사해서 쓴다.  cp .env.example .env.local
#
# ⚠️ NEXT_PUBLIC_ 값은 빌드 결과물에 그대로 박혀 브라우저로 내려간다 — 비밀값을 넣지 않는다.
#    정적 내보내기라 값을 바꾸면 재빌드해야 한다.

# 맞춤정장 API 주소. 비우면 "화면 확인 단계" — 임시 원단 목록으로 돌고 로그인 · 예약이 닫힌다. 로컬 API 는 8081.
NEXT_PUBLIC_API_BASE=http://localhost:8081

# 빌드할 때만 쓰는 API 주소(선택). 운영 서버의 빌더가 내부 주소(http://api:8080)를 넣는다 — 로컬에서는 비워 둔다.
API_BUILD_BASE=

# 사이트 정식 주소 (https://… , 끝에 / 없이). 공유 미리보기 · sitemap 의 절대 주소에 쓴다. 비우면 둘 다 만들지 않는다.
NEXT_PUBLIC_SITE_URL=
